# Copy this file to .env and fill in your values.
# .env is listed in .gitignore — never commit real credentials.

# HuggingFace token (required for gated models like Llama)
HUGGINGFACEHUB_API_TOKEN=hf_your_token_here

# OpenAI-compatible API key (set to "lm-studio" for a local LM Studio endpoint)
OPENAI_API_KEY=lm-studio

# Absolute path to the data root directory.
# Defaults to <project_root>/data if not set.
# DATA_DIR=C:/path/to/your/data
